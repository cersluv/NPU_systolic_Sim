//=========================================================
// UART_MATRIX_WRITER - Envía resultados de matriz 4x4 por UART
// Formato: "Matrix Result:\n[row0] val val val val\n[row1] ..."
//=========================================================
module uart_matrix_writer (
    input  wire                         clk,
    input  wire                         reset_n,
    input  wire                         start_send,
    input  wire signed [31:0]          result_matrix [0:3][0:3],
    output reg                          done,
    output reg                          chipselect,
    output reg                          address,
    output reg                          read_n,
    output reg                          write_n,
    output reg [31:0]                   writedata,
    input  wire                         waitrequest
);

    typedef enum logic [3:0] {
        IDLE,
        SEND_HEADER,
        SEND_ROW_LABEL,
        LOAD_VALUE,
        CONVERT_DIGIT,
        SEND_DIGIT,
        SEND_SPACE,
        SEND_NEWLINE,
        WAIT_DONE,
        FINISHED
    } state_t;

    state_t state;
    logic [7:0] tx_char;

    // Posición de header
    reg [3:0] header_index;
    reg [2:0] label_index;
    reg [1:0] row;
    reg [1:0] col;
    reg [3:0] digit_index;
    reg [7:0] number_buffer [0:10];
    reg [3:0] number_length;
    reg signed [31:0] value;
    reg signed [31:0] temp_value;
    reg negative;

    // Buffers
    reg [7:0] header_msg [0:13];
    initial begin
        header_msg[0]  = "M";
        header_msg[1]  = "a";
        header_msg[2]  = "t";
        header_msg[3]  = "r";
        header_msg[4]  = "i";
        header_msg[5]  = "x";
        header_msg[6]  = " ";
        header_msg[7]  = "R";
        header_msg[8]  = "e";
        header_msg[9]  = "s";
        header_msg[10] = "u";
        header_msg[11] = "l";
        header_msg[12] = "t";
        header_msg[13] = ":";
    end

    // UART control
    reg sending;
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            state <= IDLE;
            done <= 0;
            chipselect <= 0;
            address <= 0;
            read_n <= 1;
            write_n <= 1;
            writedata <= 32'd0;
            header_index <= 0;
            row <= 0;
            col <= 0;
            digit_index <= 0;
            label_index <= 0;
            sending <= 0;
        end else begin
            case (state)
                IDLE: begin
                    done <= 0;
                    if (start_send && !sending) begin
                        sending <= 1;
                        header_index <= 0;
                        state <= SEND_HEADER;
                    end
                end

                SEND_HEADER: begin
                    if (header_index <= 13) begin
                        tx_char <= header_msg[header_index];
                        header_index <= header_index + 1;
                        state <= WAIT_DONE;
                    end else begin
                        tx_char <= 8'h0A; // newline
                        state <= WAIT_DONE;
                    end
                end

                SEND_ROW_LABEL: begin
                    case (label_index)
                        0: tx_char <= "["; 
                        1: tx_char <= 8'h30 + row;
                        2: tx_char <= "]";
                        3: tx_char <= " ";
                        default: tx_char <= " ";
                    endcase
                    label_index <= label_index + 1;
                    if (label_index == 3)
                        state <= LOAD_VALUE;
                    else
                        state <= WAIT_DONE;
                end

                LOAD_VALUE: begin
                    value <= result_matrix[row][col];
                    temp_value <= (result_matrix[row][col] < 0) ? -result_matrix[row][col] : result_matrix[row][col];
                    negative <= (result_matrix[row][col] < 0);
                    number_length <= 0;
                    digit_index <= 0;

                    if (result_matrix[row][col] == 0) begin
                        number_buffer[0] <= "0";
                        number_length <= 1;
                        state <= SEND_DIGIT;
                    end else begin
                        state <= CONVERT_DIGIT;
                    end
                end

                CONVERT_DIGIT: begin
                    if (temp_value != 0) begin
                        number_buffer[number_length] <= 8'h30 + (temp_value % 10);
                        temp_value <= temp_value / 10;
                        number_length <= number_length + 1;
                    end else begin
                        if (negative) begin
                            number_buffer[number_length] <= "-";
                            number_length <= number_length + 1;
                        end
                        state <= SEND_DIGIT;
                        digit_index <= number_length;
                    end
                end

                SEND_DIGIT: begin
                    if (digit_index > 0) begin
                        digit_index <= digit_index - 1;
                        tx_char <= number_buffer[digit_index - 1];
                        state <= WAIT_DONE;
                    end else begin
                        state <= SEND_SPACE;
                    end
                end

                SEND_SPACE: begin
                    if (col == 3) begin
                        tx_char <= 8'h0A; // newline
                        state <= WAIT_DONE;
                    end else begin
                        tx_char <= " ";
                        state <= WAIT_DONE;
                    end
                end

                SEND_NEWLINE: begin
                    tx_char <= 8'h0A;
                    state <= WAIT_DONE;
                end

                WAIT_DONE: begin
                    chipselect <= 1;
                    write_n <= 0;
                    writedata <= {24'b0, tx_char};
                    state <= FINISHED;
                end

                FINISHED: begin
                    if (!waitrequest) begin
                        chipselect <= 0;
                        write_n <= 1;
                        if (state == FINISHED) begin
                            if (state == SEND_HEADER) begin
                                state <= SEND_ROW_LABEL;
                                label_index <= 0;
                            end else if (state == WAIT_DONE) begin
                                if (digit_index > 0) begin
                                    state <= SEND_DIGIT;
                                end else if (state == SEND_SPACE) begin
                                    if (col < 3) begin
                                        col <= col + 1;
                                        state <= LOAD_VALUE;
                                    end else if (row < 3) begin
                                        row <= row + 1;
                                        col <= 0;
                                        label_index <= 0;
                                        state <= SEND_ROW_LABEL;
                                    end else begin
                                        tx_char <= 8'h0A;
                                        state <= WAIT_DONE;
                                    end
                                end else begin
                                    done <= 1;
                                    sending <= 0;
                                    state <= IDLE;
                                end
                            end
                        end
                    end
                end
            endcase
        end
    end

endmodule
